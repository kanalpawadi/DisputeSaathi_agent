# Copy to .env and fill in. Never commit .env.
# Provider: auto | claude | groq | offline (auto picks Claude, then Groq, then offline)
DS_LLM_PROVIDER=auto

# Groq (free tier at console.groq.com)
GROQ_API_KEY=
# DS_GROQ_MODEL=openai/gpt-oss-120b
# DS_GROQ_VISION_MODEL=qwen/qwen3.8-27b   (reads bill photos; empty = off)

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# DS_LLM_MODEL=claude-opus-5-5
